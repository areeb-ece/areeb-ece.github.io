---
import { loadSite } from "../lib/site.ts";
import Sidebar from "../components/Sidebar.astro";
import Sky from "../components/Sky.astro";
import type { Page } from "../lib/tree.ts";
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  /** The page being shown, for highlighting it in the sidebar. */
  page?: Page | null;
  font?: string;
  /** "home" | "page" | "none": which typing sequence runs. */
  typing?: "home" | "page" | "none";
}

const { title, description, page = null, font, typing = "none" } = Astro.props;
const site = await loadSite();
const { config } = site;
const fontName = font ?? config.fonts.default;
// The upright files of the page's text face and of the code face: every page uses both
// (the wordmark and the typed Markdown are set in the code face). Italics load when used.
const upright = (name: string) => Object.entries(config.fonts.registry[name].files).filter(([k]) => !k.endsWith("italic")).map(([, src]) => src);
const preload = [...new Set([...upright(fontName), ...upright(config.fonts.code)])];
const isHome = typing === "home";
const fullTitle = isHome ? `${config.wordmark.left}/${config.wordmark.right}` : `${title} · ${config.wordmark.left}/${config.wordmark.right}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
// Scripts only from this site; style attributes are allowed because KaTeX and the
// code highlighter position and colour things with them. Nothing is fetched at runtime.
const csp = "default-src 'none'; script-src 'self'; style-src 'self'; style-src-attr 'unsafe-inline'; font-src 'self'; img-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; object-src 'none'; frame-src 'none'; manifest-src 'none'";
---
<!doctype html>
<html lang="en" data-theme="dark" data-font={fontName} data-typing={typing}>
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
{import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp}>}
<meta name="referrer" content="no-referrer">
<title>{fullTitle}</title>
<meta name="description" content={description || config.description}>
<meta name="author" content="areeb">
<link rel="canonical" href={canonical}>
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
{preload.map((href) => <link rel="preload" href={href} as="font" type="font/woff2" crossorigin>)}
<!-- Shared with PrereqFlow, OTU Calendar and Satisfactory Tools (public/design/): the master palette and its
     themes, the settings panel and the night sky, and the visitor's saved settings. -->
<link rel="stylesheet" href="/design/tokens.css">
<link rel="stylesheet" href="/design/ui.css">
<link rel="stylesheet" href="/fonts.css">
<script is:inline src="/design/theme.js"></script>
<script is:inline src="/js/boot.js"></script>
<script is:inline src="/design/ui.js" defer></script>
<slot name="head" />
</head>
<body>
<a class="skip" href="#main">Skip to content</a>
<Sky />
<div class="shell" id="shell">
  <Sidebar current={page} />
  <main class="main" id="main">
    <slot />
  </main>
</div>
<script>
  import "../client/typing.js";
</script>
</body>
</html>
