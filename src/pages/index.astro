---
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import ContactPanel from "../components/ContactPanel.astro";
import KatexStyles from "../components/KatexStyles.astro";
import { loadSite } from "../lib/site.ts";

const { config, intro, home } = await loadSite();
const all = [...intro.blocks, ...(home?.blocks ?? [])];
const hasMath = intro.hasMath || !!home?.hasMath;
const hasMermaid = all.some((b) => b.html.includes('class="diagram mermaid"'));
---
<Base title={config.title} typing="home">
  {hasMath && <KatexStyles slot="head" />}
  {hasMermaid && <link slot="head" rel="stylesheet" href="/diagrams.css" />}
  <div class="home">
    <header class="hero">
      <div class="hero-main">
        <h1 class="hero-title b" data-kind="title" data-src={config.title}>{config.title}</h1>
        <Blocks blocks={intro.blocks} class="hero-intro" />
      </div>
      <ContactPanel />
    </header>
    {home && home.blocks.length > 0 && <Blocks blocks={home.blocks} />}
  </div>
</Base>
