---
import Base from "../layouts/Base.astro";
---
<Base title="Not found">
  <article class="page notfound sheet">
    <header class="ph">
      <p class="crumbs lbl">404</p>
      <h1>Nothing here.</h1>
    </header>
    <div class="prose">
      <p>That page doesn't exist, or it moved. Try the sidebar, or go back to the <a href="/">home page</a>.</p>
    </div>
  </article>
</Base>
