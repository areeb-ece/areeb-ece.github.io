---
import Base from "../layouts/Base.astro";
import Blocks from "../components/Blocks.astro";
import ChildList from "../components/ChildList.astro";
import KatexStyles from "../components/KatexStyles.astro";
import { loadSite } from "../lib/site.ts";
import { bannerHtml } from "../lib/card.ts";
import { inlineLinks } from "../lib/html.ts";
import { ancestors, type Page } from "../lib/tree.ts";

export async function getStaticPaths() {
  const site = await loadSite();
  return site.pages.map((page) => ({ params: { slug: page.slug }, props: { slug: page.slug } }));
}

const site = await loadSite();
const page = site.tree.bySlug.get(Astro.props.slug) as Page;
const r = site.rendered.get(page.slug)!;
const crumbs = [...ancestors(page), page];
const img = site.banner(page);
const hasMermaid = r.blocks.some((b) => b.html.includes('class="diagram mermaid"'));
const date = page.fm.date ? new Date(page.fm.date + "T12:00:00Z") : null;
---
<Base title={page.fm.title} description={page.fm.description} page={page} font={page.fm.font} typing={page.fm.animate ? "page" : "none"}>
  {r.hasMath && <KatexStyles slot="head" />}
  {hasMermaid && <link slot="head" rel="stylesheet" href="/diagrams.css" />}
  <article class="page sheet">
    <div class="banner-strip b" data-kind="media" data-src={img ? `![${page.fm.bannerAlt ?? ""}](${page.fm.banner ?? "./" + page.banner!.split("/").pop()})` : ""} set:html={bannerHtml(page, img, page.fm.bannerAlt ?? "", "banner") + (img && page.fm.bannerCredit ? `<p class="banner-credit">${inlineLinks(page.fm.bannerCredit)}</p>` : "")} />
    <header class="ph">
      <nav class="crumbs lbl" aria-label="Breadcrumb">
        <ol>
          {crumbs.map((c, i) => (
            <li>{i < crumbs.length - 1 ? <a href={c.url}>{c.fm.title}</a> : <span aria-current="page">{c.fm.title}</span>}</li>
          ))}
        </ol>
      </nav>
      <h1 class="b" data-kind="text" data-src={`# ${page.fm.title}`}>{page.fm.title}</h1>
      {date && (
        <p class="ph-date lbl b" data-kind="text" data-src={`date: ${page.fm.date}`}>
          <time datetime={page.fm.date}>{date.toLocaleDateString("en-CA", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}</time>
        </p>
      )}
      {page.fm.draft && <p class="note warn">Draft: this page is only visible while running the site locally.</p>}
    </header>
    <Blocks blocks={r.blocks} />
    <ChildList page={page} />
  </article>
</Base>
