{
  "name": "areeb-ece.github.io",
  "version": "1.0.0",
  "description": "areeb's portfolio: degree projects and small tools, written in Markdown.",
  "private": true,
  "type": "module",
  "author": "areeb",
  "homepage": "https://areeb-ece.github.io/",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "new": "node scripts/new-page.ts",
    "test": "node --test \"tests/*.test.ts\"",
    "test:browser": "node tests/browser-check.js",
    "check": "npm test && npm run build && npm run test:browser"
  },
  "dependencies": {
    "astro": "7.3.8",
    "katex": "0.19.0",
    "mermaid": "12.1.0",
    "rehype-katex": "7.0.1",
    "rehype-stringify": "10.0.1",
    "remark-directive": "4.0.0",
    "remark-gfm": "4.0.1",
    "remark-math": "6.0.0",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "shiki": "4.5.0",
    "unified": "11.0.5",
    "wavedrom": "3.7.0",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/hast": "3.0.5",
    "@types/mdast": "4.0.4",
    "playwright": "1.56.1"
  },
  "overrides": {
    "katex": "$katex"
  }
}
